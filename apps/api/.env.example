DATABASE_URL=postgresql://docpilot:docpilot_dev_password@localhost:5432/docpilot

# Set to true to run the app with no AWS/Anthropic/Voyage credentials at all —
# every external call is swapped for an in-process fake (see src/infra/*.mock.ts).
# Leave false (or unset) to use the real services below.
MOCK_EXTERNAL_SERVICES=false

AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=replace-with-iam-access-key-id
AWS_SECRET_ACCESS_KEY=replace-with-iam-secret-access-key
S3_BUCKET_NAME=replace-with-your-bucket-name

ANTHROPIC_API_KEY=replace-with-your-anthropic-api-key
VOYAGE_API_KEY=replace-with-your-voyage-api-key
